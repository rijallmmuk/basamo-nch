flowchart TB
    %% STAKEHOLDERS
    subgraph Actors ["1. Pemangku Kepentingan & Pengguna"]
        direction LR
        Warga["Warga Nagari<br/>(Peserta Belajar & Pengguna)"]
        UMKM["Pelaku UMKM Warga<br/>(Pengelola Lapak Dagang)"]
        Pengajar["Instruktur / Pengajar PkM<br/>(Penyusun Modul Ajar)"]
        Operator["Perangkat & Operator Nagari<br/>(Pemerintah Nagari)"]
        DPMD["DPMD & Pemangku Kebijakan<br/>(Pengawas Pembangunan)"]
    end

    %% GATEWAY & ACCESS
    subgraph Gateway ["2. Gerbang Akses Multi-Tenant & Otentikasi"]

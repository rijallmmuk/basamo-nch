    subgraph CorePlatform ["3. Pilar Modul Kanonik Platform BASAMO NCH"]
        direction TB

        subgraph Teras ["Teras Nagari"]
            SDGs["Dashboard 18 Indikator SDGs Nagari<br/>(4 Pilar Pembangunan Berkelanjutan)"]
            IDM["Monitoring Indeks Desa Membangun (IDM)"]
        end

        subgraph Balinduang ["Medan Nan Balinduang (Smart Learning Center / LMS)"]

        Subdomain["Subdomain Nagari Mitra<br/>({slug}.basamonch.com)<br/>Wajah Nagari Terisolasi"]
        PortalInduk["Portal Induk NCH Aggregator<br/>(basamonch.com)<br/>Monitoring Lintas Nagari"]
        AuthGateway["Gerbang Otentikasi Terpadu<br/>• Warga: Login NIK Kependudukan<br/>• Pengelola: Login Username"]
    end


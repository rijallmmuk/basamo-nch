# Basamo NCH — Smart Learning Center
# Produksi: APP_ENV=production, APP_DEBUG=false, APP_URL=https://basamonch.com
APP_NAME="Basamo NCH Smart Learning Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Password awal bersama untuk akun yang dibuatkan operator; WAJIB diisi, minimal 8
# karakter. Pemiliknya dipaksa menggantinya saat pertama masuk. Jangan pernah
# menuliskan nilainya di dalam kode: berkas kode ikut ke repo, berkas ini tidak.
INITIAL_PASSWORD=
# Opsional, hanya bila satu peran perlu password awal yang berbeda dari yang di atas.
# Yang dikosongkan otomatis memakai INITIAL_PASSWORD.
INITIAL_PASSWORD_SUPERADMIN=
INITIAL_PASSWORD_OPERATOR=
INITIAL_PASSWORD_PENGAJAR=
INITIAL_PASSWORD_DPMD=
INITIAL_PASSWORD_WARGA=
# Domain dasar situs nagari ({slug}.domain). Produksi: basamonch.com.
# Pada Hostinger Web/Cloud, buat setiap subdomain dan SSL-nya secara individual.
PUBLIC_BASE_DOMAIN=localhost
APP_TIMEZONE=Asia/Jakarta

# false untuk koneksi langsung Hostinger. Ubah true hanya bila memakai Cloudflare,
# Hostinger CDN, atau reverse proxy lain, lalu isi IP/CIDR-nya dengan tepat.
REVERSE_PROXY_ENABLED=false
# Gunakan * hanya jika origin benar-benar tidak dapat diakses langsung.
TRUSTED_PROXIES=

# HSTS otomatis aktif saat APP_ENV=production dan request terdeteksi HTTPS.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
EXCEPTION_REPORTS_PER_MINUTE=60
HEALTH_CHECKS_ENABLED=true
RETENTION_READ_NOTIFICATIONS_DAYS=90
RETENTION_CONTACT_MESSAGES_DAYS=730
RETENTION_TRASHED_CONTACT_MESSAGES_DAYS=90
RETENTION_FAILED_JOBS_HOURS=720

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error/performance monitoring. PII dan SQL bindings sengaja tidak dikirim.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_BREADCRUMBS_SQL_BINDINGS_ENABLED=false
SENTRY_TRACE_SQL_BINDINGS_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=basamo_nch
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Sesi bertahan 8 jam sejak aktivitas terakhir (satu hari kerja penuh), bukan 2 jam.
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
# Produksi wajib `.basamonch.com` agar login yang dimulai di subdomain tetap hidup
# ketika peran lintas nagari diarahkan ke domain utama.
SESSION_DOMAIN=null
# Umur cookie "Ingat saya". Kosongkan/hapus untuk memakai 30 hari.
AUTH_REMEMBER_DAYS=30
# Produksi (HTTPS): ubah ke true. Biarkan false untuk dev HTTP lokal.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SLC_MATERIAL_DISK=local
# Disk semua unggahan publik (cover modul, foto produk & sampul nagari, PDF materi).
# KEPUTUSAN: storage server hosting saja (disk 'public' + symlink), TANPA object
# storage cloud. Saat deploy: `php artisan storage:link` & pastikan APP_URL benar.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email belum digunakan; notifikasi aplikasi tetap tersimpan di database.
MAIL_ENABLED=false
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage & backup memakai server hosting saja (tanpa cloud). Kredensial AWS_* di
# bawah TIDAK dipakai; biarkan kosong kecuali kelak beralih ke object storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backup di server hosting saja (backup_local), tanpa salinan off-site cloud.
# Catatan: bila server/hosting hilang, backup ikut hilang (risiko diterima).
BACKUP_DISKS=backup_local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_LOG_CHANNEL=stack
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=auto
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=true
BACKUP_DB_DUMP_TIMEOUT=300

VITE_APP_NAME="${APP_NAME}"

# Catatan: berkas materi SLC maks 20 MB, TAPI fitur Restore Backup butuh hingga 1 GB!
# Pastikan PHP server (php.ini) di Hostinger disetel minimal:
#   upload_max_filesize=1024M, post_max_size=1024M
# `php artisan ops:production-check` membaca nilai TERKECIL dari kedua direktif,
# jadi keduanya harus dinaikkan, bukan salah satu saja.

# Token panel EWS banjir bandang (Blynk Cloud), satu per nagari terpasang.
# Kosongkan bila lingkungan ini tidak punya perangkatnya; seeder akan melewatinya.
EWS_RETENSI_HARI=90
EWS_TOKEN_TANJUNG_HARO=
EWS_TOKEN_KOTO_TANGAH=
EWS_TOKEN_PANGIAN=

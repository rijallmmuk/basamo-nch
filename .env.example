# Basamo NCH — Smart Learning Center
# Produksi: APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain-anda
APP_NAME="Basamo NCH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=basamo_nch
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk untuk semua unggahan publik (cover modul, foto produk, PDF materi).
# Default 'public' (lokal + symlink). Untuk produksi R2: set MEDIA_DISK=s3.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage produksi (Cloudflare R2): set FILESYSTEM_DISK=s3 DAN MEDIA_DISK=s3
# (MEDIA_DISK mengatur semua unggahan: gambar + PDF) + isi kredensial,
# AWS_ENDPOINT (URL R2), dan AWS_USE_PATH_STYLE_ENDPOINT=true.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Catatan: upload PDF materi maks 10 MB. Pastikan PHP server:
#   upload_max_filesize=10M, post_max_size=12M (lihat docs/DECISIONS.md).
